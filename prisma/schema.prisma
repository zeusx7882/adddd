generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id              String   @id @default(cuid())
  discordId       String   @unique
  discordUsername String
  discordAvatar   String?
  createdAt       DateTime @default(now())
}

model Game {
  id        String   @id @default(cuid())
  name      String
  appId     String   @unique
  imageUrl  String?
  createdAt DateTime @default(now())
}

model ActivationKey {
  id        String   @id @default(cuid())
  key       String   @unique
  appId     String
  gameName  String?
  used      Boolean  @default(false)
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@map("activation_keys")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  adminId   String
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
