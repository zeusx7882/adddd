# URL pública da API externa de keys (sem segredo — pode ser exposta ao browser)
NEXT_PUBLIC_API_BASE_URL=https://byzeuskeys.shardweb.app

# Banco de dados PostgreSQL — usado APENAS no servidor (painel admin)
# Não coloque este valor em variáveis NEXT_PUBLIC_ nem em código client-side.
DATABASE_URL="******HOST:5432/DB_NAME?sslmode=require"

# NextAuth
NEXTAUTH_URL="https://laucherfreedrop.shardweb.app"
NEXTAUTH_SECRET="gere-um-segredo-seguro-com-openssl-rand-base64-32"

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID="seu_discord_client_id"
DISCORD_CLIENT_SECRET="seu_discord_client_secret"

# Discord ID do administrador autorizado
ADMIN_DISCORD_ID="seu_discord_id_aqui"

# Porta do servidor (opcional; a Shard Cloud normalmente fornece PORT automaticamente)
# PORT="3000"
