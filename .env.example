# URL pública da API externa de keys (sem segredo — pode ser exposta ao browser)
NEXT_PUBLIC_API_BASE_URL=https://byzeuskeys.shardweb.app

# Banco de dados PostgreSQL — usado APENAS no servidor (painel admin)
# Não coloque este valor em variáveis NEXT_PUBLIC_ nem em código client-side.
# Use o MESMO DATABASE_URL tanto no admin quanto na API externa.
DATABASE_URL=******host:5432/db?sslmode=require

# NextAuth
NEXTAUTH_URL=https://laucherfreedrop.shardweb.app
NEXTAUTH_SECRET=gere-um-segredo-com-openssl-rand-base64-32

# Discord OAuth2 — https://discord.com/developers/applications
# Application ID: 1540905020793290752
DISCORD_CLIENT_ID=1540905020793290752
DISCORD_CLIENT_SECRET=

# Redirect URI para o launcher (adicionar no Discord Developer Portal)
LAUNCHER_DISCORD_REDIRECT_URI=https://laucherfreedrop.shardweb.app/api/auth/callback/launcher

# Discord IDs dos administradores autorizados (separados por vírgula)
# Ex: ADMIN_DISCORD_IDS=123456789,987654321
ADMIN_DISCORD_IDS=
# Compatibilidade com versão anterior (aceita um único ID)
ADMIN_DISCORD_ID=

# Porta do servidor (opcional; a Shard Cloud fornece PORT automaticamente)
# PORT=3000

# Otimização de memória para o build Next.js (recomendado em hospedagens com 2048 MB)
# NODE_OPTIONS=--max-old-space-size=1536
